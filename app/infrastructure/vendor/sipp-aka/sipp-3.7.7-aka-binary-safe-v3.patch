+#ifndef SIPP_AKA_BINARY_PARAM_HPP
+#define SIPP_AKA_BINARY_PARAM_HPP
+
+#include <cstddef>
+
+namespace sipp_aka {
+
+inline int hex_digit(char c)
+{
+    if(c >= '0' && c <= '9') return c - '0';
+    if(c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if(c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+// Keep the exact bytes that SIPp's former 0x decoder produced, including
+// odd final nibbles, but pass them through SendingMessage as literal \xHH.
+// SendingMessage decodes the escape into a length-tracked binary component.
+inline bool hex_to_escaped(const char *hex, char *out, std::size_t capacity,
+        std::size_t *decoded_bytes)
+{
+    static const char digits[] = "0123456789ABCDEF";
+    if(!hex || !out || !capacity) return false;
+    std::size_t used = 0;
+    std::size_t count = 0;
+    while(true) {
+        int high = hex_digit(*hex);
+        if(high < 0) break;
+        ++hex;
+        int low = hex_digit(*hex);
+        int byte = high;
+        if(low >= 0) {
+            byte = (high << 4) | low;
+            ++hex;
+        }
+        if(used + 4 >= capacity) return false;
+        out[used++] = '\\';
+        out[used++] = 'x';
+        out[used++] = digits[(byte >> 4) & 0x0f];
+        out[used++] = digits[byte & 0x0f];
+        ++count;
+    }
+    out[used] = '\0';
+    if(decoded_bytes) *decoded_bytes = count;
+    return true;
+}
+
+} // namespace sipp_aka
+#endif
