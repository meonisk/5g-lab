# Prefer scripts/initialize_local.py; for manual setup copy to local/secrets/ims.env. This value is the non-production laboratory IMS Digest
# credential. Never use a production Ki as a SIP Digest password.
IMS_DIGEST_PASSWORD=replace-with-local-lab-secret
SUBSCRIBER_K=replace-with-local-lab-k
SUBSCRIBER_OPC=replace-with-local-lab-opc
SUBSCRIBER_AMF=8000
