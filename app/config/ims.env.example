# Prefer scripts/initialize_local.py; for manual setup copy to local/secrets/ims.env. This value is the non-production laboratory IMS Digest
# credential. Never use a production Ki as a SIP Digest password.
IMS_DIGEST_PASSWORD=replace-with-local-lab-secret
# New stands: independent 5GS and IMS AKA credentials for each UE.
UE1_5GS_K=replace-with-32-hex-chars
UE1_5GS_OPC=replace-with-32-hex-chars
UE1_5GS_AMF=8000
UE1_IMS_K=replace-with-32-hex-chars
UE1_IMS_OPC=replace-with-32-hex-chars
UE1_IMS_AMF=8000
UE2_5GS_K=replace-with-32-hex-chars
UE2_5GS_OPC=replace-with-32-hex-chars
UE2_5GS_AMF=8000
UE2_IMS_K=replace-with-32-hex-chars
UE2_IMS_OPC=replace-with-32-hex-chars
UE2_IMS_AMF=8000
# Existing stands may retain SUBSCRIBER_K/OPC/AMF as a complete legacy fallback.

# Local OAI core only: initialize_local.py generates OAI_DB_PASSWORD and
# OAI_DB_ROOT_PASSWORD once (48 hex chars). Partner --ims-only needs neither.
