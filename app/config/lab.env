# Единственный файл настроек стенда IMS + AI. Секретов здесь нет: ключи SIM
# лабораторные. Compose читает файл через --env-file, скрипты — напрямую.

# --- Идентичность сети: IMS-домен выводится из MCC/MNC ---------------------
MCC=001
MNC=01
IMS_DOMAIN=ims.mnc001.mcc001.3gppnetwork.org

# --- Сеть ядра OAI, к которой подключаются все контейнеры IMS и AI ----------
# Имя Docker-сети ядра (docker network ls) и её подсеть (docker network inspect).
CORE_NETWORK_NAME=oai-cn5g
LAB_NETWORK_CIDR=192.168.70.128/26
# UPF ядра: через него IMS отвечает UE (в IMS DNN нет NAT).
UPF_IP=192.168.70.134
# Пулы адресов UE из конфигурации SMF ядра.
IMS_UE_CIDR=12.1.1.0/24
INTERNET_UE_CIDR=12.1.1.0/24
IMS_DNN=ims

# Статические адреса IMS и AI внутри LAB_NETWORK_CIDR, свободные в сети ядра.
DNS_IP=192.168.70.160
RTPENGINE_IP=192.168.70.161
MYSQL_IP=192.168.70.162
PYHSS_IP=192.168.70.163
ICSCF_IP=192.168.70.164
SCSCF_IP=192.168.70.165
PCSCF_IP=192.168.70.166
SIP_AS_IP=192.168.70.167
AI_WORKER_IP=192.168.70.168
VOICE_AGENT_IP=192.168.70.169
SIPUE1_IP=192.168.70.170
SIPUE2_IP=192.168.70.171
# Разовый загрузчик Qwen: адрес нужен только на время скачивания.
LLM_INIT_IP=192.168.70.172
# Заглушка SCP для шаблонов N5 в P-CSCF: N5 выключен, адрес не используется.
SCP_IP=192.168.70.166

# --- Абоненты: телефоны (UE1, UE2) и тестовые SIP-клиенты (SIPUE1, SIPUE2) --
# Ключи телефонов совпадают с SIM-картами и записью в UDR ядра.
UE1_IMSI=001010000000001
UE1_MSISDN=1001
UE1_IMS_K=FEC86BA6EB707ED08905757B1BB44B8F
UE1_IMS_OPC=C42449363BBAD02B66D16BC975D77CC1
UE1_IMS_AMF=8000
UE2_IMSI=001010000000002
UE2_MSISDN=1002
UE2_IMS_K=FEC86BA6EB707ED08905757B1BB44B8F
UE2_IMS_OPC=C42449363BBAD02B66D16BC975D77CC1
UE2_IMS_AMF=8000
# Тестовые клиенты PJSUA регистрируются по SIP Digest (пароль = K) прямо из
# сети ядра, без 5G. Отдельные IMSI не мешают телефонам UE1/UE2.
SIPUE1_IMSI=001010000000101
SIPUE1_MSISDN=1101
SIPUE1_IMS_K=F9843015F8DECFE11ADC8F20995AF4EE
SIPUE1_IMS_OPC=9F02534811F04CABA6C1BC8579114E49
SIPUE1_IMS_AMF=8000
SIPUE2_IMSI=001010000000102
SIPUE2_MSISDN=1102
SIPUE2_IMS_K=18C6BA5C51C8C28D75815DE82AFFCE4A
SIPUE2_IMS_OPC=E80B865F75316070943A53B036FA728A
SIPUE2_IMS_AMF=8000

# --- Порты IMS ---------------------------------------------------------------
PCSCF_SIP_PORT=5060
PCSCF_UDP_MTU=65535
ICSCF_SIP_PORT=5060
SCSCF_SIP_PORT=6060
PCSCF_BIND_PORT=3871
ICSCF_BIND_PORT=3869
SCSCF_BIND_PORT=3870
PYHSS_BIND_PORT=3868
# Заглушка из шаблонов docker_open5gs; Rx к PCRF не используется.
PCRF_BIND_PORT=3873
PYHSS_API_BIND=127.0.0.1
PYHSS_API_PORT=8088
PYHSS_API_CONTAINER_PORT=8080
RTPENGINE_NG_PORT=2223
RTPENGINE_CLI_PORT=9901
RTPENGINE_PORT_MIN=30000
RTPENGINE_PORT_MAX=30100
RTPENGINE_QUERY_TIMEOUT_SECONDS=0.5
LOOPBACK_IP=127.0.0.1
DNS_UPSTREAM_PRIMARY=8.8.8.8
DNS_UPSTREAM_SECONDARY=8.8.4.4

# --- Тестовые SIP-клиенты PJSUA (профиль compose "test") ---------------------
SIP_UE_AUTO_ANSWER=200
SIP_UE_TEST_UTTERANCE="Привет, локальный голосовой агент. Сколько будет пять плюс семь?"
SIP_UE_CODEC=PCMU/8000
INTERPRETER_DIALOGUE_UE1_FILE=fixtures/ue1-ru-RU.wav
INTERPRETER_DIALOGUE_UE2_FILE=fixtures/ue2-en-US.wav

# --- Номера услуг AI ---------------------------------------------------------
VOICE_AGENT_MSISDN=1003
VOICE_TRANSLATOR_MSISDN=1003
VOICE_TRANSCRIBER_MSISDN=1004
VOICE_INTERPRETER_RU_MSISDN=1005
VOICE_INTERPRETER_EN_MSISDN=1006
VOICE_AGENT_SIP_USER=agent
VOICE_TRANSCRIBER_SIP_USER=transcriber
VOICE_INTERPRETER_RU_SIP_USER=interpreter-ru
VOICE_INTERPRETER_EN_SIP_USER=interpreter-en

# --- Порты и параметры AI-сервисов ------------------------------------------
SIP_AS_PORT=5070
MEDIA_ADAPTER_PORT=8091
AI_WORKER_PORT=8092
AI_WORKER_BIND=0.0.0.0
VOICE_AGENT_HTTP_PORT=8093
VOICE_AGENT_RTP_PORT=41000
MEDIA_OBSERVE_INTERVAL_SECONDS=0.1
MEDIA_SESSION_TTL_SECONDS=120
MEDIA_AUDIO_MAX_BYTES=32000

# --- Распознавание речи (faster-whisper) ------------------------------------
AI_BACKEND=faster-whisper
AI_TRANSLATION_BACKEND=llm
AI_TRANSCRIPT_NORMALIZATION=llm
AI_TRANSLATION_MODEL_ROOT=/translation-models
AI_TRANSLATION_THREADS=2
AI_TRANSLATION_BEAM_SIZE=4
AI_STT_CPU_THREADS=4
AI_MODEL_SIZE=small
AI_MODEL_REVISION=536b0662742c02347bc0e980a01041f333bce120
AI_DEVICE=cpu
AI_ENABLE_CUDA=0
AI_CONTAINER_RUNTIME=runc
AI_GPU_DEVICES=void
AI_COMPUTE_TYPE=int8
AI_LANGUAGE=ru
AI_STT_MIN_RMS=0.005
AI_STT_BEAM_SIZE=1
AI_MODEL_CACHE=/models
AI_HF_DISABLE_XET=1

# --- Границы реплик ----------------------------------------------------------
AI_VAD_RMS=350
AI_UTTERANCE_MIN_SECONDS=0.35
AI_UTTERANCE_SILENCE_MS=700
AI_UTTERANCE_MAX_SECONDS=5
AI_DIALOGUE_UTTERANCE_SILENCE_MS=600
AI_DIALOGUE_UTTERANCE_MAX_SECONDS=10
AI_DIALOGUE_EVENT_GAP_MS=1200
AI_AUDIO_PREROLL_MS=200
# Экспериментальный потоковый перевод не принят: не включать для звонков.
AI_STREAMING_ENABLED=0
AI_STREAM_INTERVAL_MS=300
AI_STREAM_MIN_WORDS=1
AI_STREAM_HOLDBACK_WORDS=1
AI_STREAM_MAX_REPLIES_PER_CALL=24
INTERPRETER_MAX_RESPONSE_DELAY_MS=5000
# Порог RMS PCM16 для первого слышимого RTP перевода (не пустого пакета).
TTS_AUDIBLE_RMS=100

# --- Очереди, лимиты и хранение событий -------------------------------------
AI_QUEUE_MAX=8
AI_UTTERANCE_QUEUE_MAX=8
AI_PROCESSING_WORKERS=2
SERVICE_HTTP_THREADS=4
AI_REQUEST_MAX_BYTES=65536
AI_TRANSCRIPT_RETENTION_SECONDS=300
AI_STREAM_BUFFER_MAX=64
AI_STREAM_BUFFER_TTL_SECONDS=30
AI_MAX_REPLIES_PER_CALL=4
AI_CONVERSATION_HISTORY_TURNS=4
AI_CONVERSATION_TTL_SECONDS=300
AI_MIN_REPLIES_FOR_SMOKE=2
AI_EVENT_RETENTION=100
AI_REPLY_HTTP_TIMEOUT_SECONDS=3

# --- LLM (Ollama + Qwen3-4B, режим baseline) --------------------------------
LLM_MODEL=unsloth-qwen3-4b-instruct:q4_k_m
LLM_GGUF_URL=https://huggingface.co/unsloth/Qwen3-4B-Instruct-2507-GGUF/resolve/a06e946bb6b655725eafa393f4a9745d460374c9/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
LLM_GGUF_SHA256=3605803b982cb64aead44f6c1b2ae36e3acdb41d8e46c8a94c6533bc4c67e597
# CPU по умолчанию. NVIDIA: runtime=nvidia и devices=all (или UUID GPU).
LLM_CONTAINER_RUNTIME=runc
LLM_GPU_DEVICES=void
LLM_CONTEXT_LENGTH=2048
LLM_WARMUP_TIMEOUT_SECONDS=180
LLM_URL=http://llm-worker:11434/api/chat
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=64
LLM_TEMPERATURE=0
LLM_KEEP_ALIVE=-1
LLM_NUM_PARALLEL=1
LLM_WORKER_CPU_LIMIT=4.0
LLM_WORKER_MEMORY_LIMIT=6g
TRANSLATION_MIN_LATIN_CHARS=3
TRANSLATION_MAX_CYRILLIC_CHARS=0
REVERSE_TRANSLATION_MIN_CYRILLIC_CHARS=3
REVERSE_TRANSLATION_MAX_LATIN_CHARS=0
LLM_SYSTEM_PROMPT="Ты локальный голосовой помощник IMS. Отвечай по-русски одним коротким предложением без Markdown. Учитывай предыдущие реплики текущего звонка."
LLM_TRANSLATION_PROMPT="Translate the user's Russian speech into natural English. Return only the English translation in one short plain sentence. Do not explain, quote the source, or use Markdown. Use prior turns only to resolve context."
LLM_REVERSE_TRANSLATION_PROMPT="Переведи английскую речь на естественный русский язык. Верни только перевод кириллицей одним коротким предложением, без пояснений, кавычек и Markdown. Имена и аббревиатуры передавай кириллицей. Предыдущие реплики используй только для контекста."
LLM_TRANSCRIPTION_PROMPT="Ты выполняешь детерминированную постобработку ASR. Перепиши расшифровку грамотным русским письменным текстом. Обязательно удали междометия и заполнители пауз (а-а, э, э-э, эм, ну), бессодержательные вводные а/но, повторы слов, заикания и оборванные ложные начала. Сохрани итоговый смысл, факты, имена, числа и порядок законченных мыслей. Не отвечай на содержание, не сокращай смысловые фразы и не переводи. Верни только готовый текст без кавычек, заголовка, пояснений и Markdown. Пример: Вход: «А... э-э... я, я хотел сказать, ну, встреча в пять. Но... а... лучше в шесть.» Выход: «Я хотел сказать: встреча в пять. Лучше в шесть.»"
LLM_ENGLISH_TRANSCRIPTION_PROMPT="You perform deterministic ASR post-processing. Return only polished English transcript text without quotes, headings, explanations, or Markdown. Fix capitalization, punctuation, and obvious recognition errors. Remove hesitation sounds, filler words, stutters, duplicated words, and abandoned false starts only when they add no meaning. Preserve names, numbers, facts, meaning, and utterance order. Do not answer, summarize, or translate the content."
LLM_NORMALIZATION_MAX_TOKENS=256
LLM_NORMALIZATION_MIN_LENGTH_RATIO=0.65
TRANSCRIPT_NORMALIZED_MAX_CHARS=2000

# --- Голосовой агент и синтез (Piper) ---------------------------------------
VOICE_AGENT_GREETING="Здравствуйте. Говорите по-русски. Перевод прозвучит на английском языке."
VOICE_TRANSCRIBER_GREETING="Внимание. После сигнала разговор записывается для локальной транскрипции."
VOICE_INTERPRETER_RU_GREETING="Русский канал переводчика подключён. Вы услышите собеседника по-русски."
VOICE_INTERPRETER_EN_GREETING="English interpreter channel connected. You will hear the other speaker in English."
VOICE_AGENT_REPLY="Я вас слышу. Медиатракт IMS работает."
VOICE_AGENT_REPLY_MAX_CHARS=240
VOICE_AGENT_LLM_MODE=1
VOICE_AGENT_VAD_RMS=350
VOICE_AGENT_SILENCE_MS=700
VOICE_AGENT_CALL_TIMEOUT=300
VOICE_AGENT_MAX_CALLS=100
VOICE_AGENT_REPLY_QUEUE_MAX=16
VOICE_AGENT_EVENT_RETENTION=100
TTS_BACKEND=piper
TTS_VOICE=ru
TTS_TRANSLATION_VOICE=en-us
TTS_RATE=145
PIPER_VERSION=1.8.0
PIPER_MODEL_URL=https://huggingface.co/rhasspy/piper-voices/resolve/c10ece1aade47bb51c153c893d14e5bf8e5b7117/ru/ru_RU/denis/medium/ru_RU-denis-medium.onnx
PIPER_MODEL_SHA256=15fab56e11a097858ee115545d0f697fc2a316c41a291a5362349fb870411b0a
PIPER_CONFIG_SHA256=831c860dac0b5073eaa81610a0a638ec23d90a6cf8e5f871b4485c2cec3767c8
PIPER_MODEL_PATH=/opt/tts/ru_RU-denis-medium.onnx
PIPER_LENGTH_SCALE=1.0
PIPER_THREADS=1
PIPER_CPU_MEM_ARENA=1
PIPER_EN_MODEL_URL=https://huggingface.co/rhasspy/piper-voices/resolve/c10ece1aade47bb51c153c893d14e5bf8e5b7117/en/en_US/ljspeech/medium/en_US-ljspeech-medium.onnx
PIPER_EN_MODEL_SHA256=6f52a751e2349abe7a76735eb09dc1875298c77ea2342ffd2fef79ff81b87f22
PIPER_EN_CONFIG_SHA256=141d612cc0a95ed7efc1ca936b845c2364967f2e9217c5dbfcf69fc4d6c65860
PIPER_EN_MODEL_PATH=/opt/tts/en_US-ljspeech-medium.onnx
PIPER_EN_LENGTH_SCALE=1.0

# --- Запись звонков на 1004 --------------------------------------------------
RECORDING_ENABLED=1
RECORDING_ROOT=/recordings
RECORDING_MAX_BYTES_PER_CALL=16000000
RECORDING_RETENTION_DAYS=7

# --- Ресурсы контейнеров и служебный токен ----------------------------------
SERVICE_CONTROL_TOKEN_FILE=/run/lab-control/token
SERVICE_CONTROL_TOKEN_BYTES=32
CUSTOM_SERVICE_CPU_LIMIT=1.0
CUSTOM_SERVICE_MEMORY_LIMIT=256m
AI_WORKER_CPU_LIMIT=4.0
AI_WORKER_MEMORY_LIMIT=2g
VOICE_AGENT_MEMORY_LIMIT=512m
CUSTOM_SERVICE_PIDS_LIMIT=128
CUSTOM_SERVICE_LOG_MAX_SIZE=10m
CUSTOM_SERVICE_LOG_MAX_FILES=3

# --- Образы: меняйте осознанно и повторяйте проверки -------------------------
CONTROL_INIT_IMAGE=alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
KAMAILIO_IMAGE=ghcr.io/herlesupreeth/docker_kamailio@sha256:efc9df818c239d28cd61a822d62ce0201b6ca3047f6fa653233bfa84498510de
SCSCF_IMAGE=lab-kamailio-scscf:987459-expiry-v1
MYSQL_IMAGE=ghcr.io/herlesupreeth/docker_mysql@sha256:a03ac89dbc7de0b0d75e5600ae6542ad9abb620a3c71848ba715a0a5926f81fc
PYHSS_IMAGE=ghcr.io/herlesupreeth/docker_pyhss@sha256:67876ced93002181933d706cb047ffee9f855f3f61a43b184a01981987853a82
OLLAMA_IMAGE=ollama/ollama@sha256:da6e0dc5651df159e45686fd663c4dbe1624a52c44d7280eeac1551d8f865532
