SIP_UE_AUTO_ANSWER=200
SIP_UE_AUTO_CONFERENCE=1
SIP_CALL_DURATION_SECONDS=20
SIP_UE_TEST_UTTERANCE="Привет, локальный голосовой агент. Сколько будет пять плюс семь?"
SIP_UE_PLAYBACK_FILE=
SIP_UE_CODEC=PCMU/8000
BILINGUAL_DIALOGUE_UE1_FILE=fixtures/ue1-ru-RU.wav
BILINGUAL_DIALOGUE_UE2_FILE=fixtures/ue2-en-US.wav
BILINGUAL_DIALOGUE_PLAYBACK_SECONDS=40
BILINGUAL_DIALOGUE_MIN_RTP_PACKETS=300
INTERPRETER_DIALOGUE_UE1_FILE=fixtures/ue1-ru-RU.wav
INTERPRETER_DIALOGUE_UE2_FILE=fixtures/ue2-en-US.wav
INTERPRETER_DIALOGUE_PLAYBACK_SECONDS=70
SIP_AS_PORT=5070
MEDIA_ADAPTER_PORT=8091
AI_WORKER_PORT=8092
AI_WORKER_BIND=0.0.0.0
MEDIA_OBSERVE_INTERVAL_SECONDS=0.1
MEDIA_SESSION_TTL_SECONDS=120
MEDIA_AUDIO_MAX_BYTES=32000
AI_BACKEND=faster-whisper
AI_MODEL_SIZE=small
AI_MODEL_REVISION=536b0662742c02347bc0e980a01041f333bce120
AI_DEVICE=cpu
AI_COMPUTE_TYPE=int8
AI_LANGUAGE=ru
AI_VAD_RMS=350
AI_UTTERANCE_MIN_SECONDS=0.35
AI_UTTERANCE_SILENCE_MS=700
AI_UTTERANCE_MAX_SECONDS=5
AI_DIALOGUE_UTTERANCE_SILENCE_MS=600
AI_DIALOGUE_UTTERANCE_MAX_SECONDS=10
AI_DIALOGUE_EVENT_GAP_MS=1200
INTERPRETER_MAX_RESPONSE_DELAY_MS=5000
# PCM16 RMS threshold for first audible translated RTP (not an empty packet).
TTS_AUDIBLE_RMS=100
AI_AUDIO_PREROLL_MS=200
AI_QUEUE_MAX=8
AI_UTTERANCE_QUEUE_MAX=8
AI_PROCESSING_WORKERS=2
SERVICE_HTTP_THREADS=4
AI_REQUEST_MAX_BYTES=65536
AI_TRANSCRIPT_RETENTION_SECONDS=300
AI_STREAM_BUFFER_MAX=64
AI_STREAM_BUFFER_TTL_SECONDS=30
AI_MAX_REPLIES_PER_CALL=4
AI_CONVERSATION_HISTORY_TURNS=4
AI_CONVERSATION_TTL_SECONDS=300
AI_MIN_REPLIES_FOR_SMOKE=2
AI_MODEL_CACHE=/models
AI_HF_DISABLE_XET=1
LLM_MODEL=unsloth-qwen3-4b-instruct:q4_k_m
LLM_GGUF_URL=https://huggingface.co/unsloth/Qwen3-4B-Instruct-2507-GGUF/resolve/a06e946bb6b655725eafa393f4a9745d460374c9/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
LLM_GGUF_SHA256=3605803b982cb64aead44f6c1b2ae36e3acdb41d8e46c8a94c6533bc4c67e597
# Portable CPU default. NVIDIA hosts: runtime=nvidia and devices=all (or GPU UUID).
LLM_CONTAINER_RUNTIME=runc
LLM_GPU_DEVICES=void
LLM_CONTEXT_LENGTH=2048
LLM_WARMUP_TIMEOUT_SECONDS=180
LLM_URL=http://llm-worker:11434/api/chat
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=64
LLM_TEMPERATURE=0
TRANSLATION_MIN_LATIN_CHARS=3
TRANSLATION_MAX_CYRILLIC_CHARS=0
REVERSE_TRANSLATION_MIN_CYRILLIC_CHARS=3
REVERSE_TRANSLATION_MAX_LATIN_CHARS=0
LLM_SYSTEM_PROMPT="Ты локальный голосовой помощник IMS. Отвечай по-русски одним коротким предложением без Markdown. Учитывай предыдущие реплики текущего звонка."
LLM_TRANSLATION_PROMPT="Translate the user's Russian speech into natural English. Return only the English translation in one short plain sentence. Do not explain, quote the source, or use Markdown. Use prior turns only to resolve context."
LLM_REVERSE_TRANSLATION_PROMPT="Переведи английскую речь на естественный русский язык. Верни только перевод кириллицей одним коротким предложением, без пояснений, кавычек и Markdown. Имена и аббревиатуры передавай кириллицей. Предыдущие реплики используй только для контекста."
LLM_TRANSCRIPTION_PROMPT="Ты выполняешь детерминированную постобработку ASR. Перепиши расшифровку грамотным русским письменным текстом. Обязательно удали междометия и заполнители пауз (а-а, э, э-э, эм, ну), бессодержательные вводные а/но, повторы слов, заикания и оборванные ложные начала. Сохрани итоговый смысл, факты, имена, числа и порядок законченных мыслей. Не отвечай на содержание, не сокращай смысловые фразы и не переводи. Верни только готовый текст без кавычек, заголовка, пояснений и Markdown. Пример: Вход: «А... э-э... я, я хотел сказать, ну, встреча в пять. Но... а... лучше в шесть.» Выход: «Я хотел сказать: встреча в пять. Лучше в шесть.»"
LLM_ENGLISH_TRANSCRIPTION_PROMPT="You perform deterministic ASR post-processing. Return only polished English transcript text without quotes, headings, explanations, or Markdown. Fix capitalization, punctuation, and obvious recognition errors. Remove hesitation sounds, filler words, stutters, duplicated words, and abandoned false starts only when they add no meaning. Preserve names, numbers, facts, meaning, and utterance order. Do not answer, summarize, or translate the content."
LLM_NORMALIZATION_MAX_TOKENS=256
LLM_NORMALIZATION_MIN_LENGTH_RATIO=0.65
TRANSCRIPT_NORMALIZED_MAX_CHARS=2000
LLM_WORKER_CPU_LIMIT=4.0
LLM_WORKER_MEMORY_LIMIT=6g
VOICE_AGENT_MSISDN=1003
VOICE_TRANSLATOR_MSISDN=1003
VOICE_TRANSCRIBER_MSISDN=1004
VOICE_INTERPRETER_RU_MSISDN=1005
VOICE_INTERPRETER_EN_MSISDN=1006
VOICE_AGENT_SIP_USER=agent
VOICE_TRANSCRIBER_SIP_USER=transcriber
VOICE_INTERPRETER_RU_SIP_USER=interpreter-ru
VOICE_INTERPRETER_EN_SIP_USER=interpreter-en
VOICE_AGENT_HTTP_PORT=8093
VOICE_AGENT_RTP_PORT=41000
VOICE_AGENT_GREETING="Здравствуйте. Говорите по-русски. Перевод прозвучит на английском языке."
VOICE_TRANSCRIBER_GREETING="Внимание. После сигнала разговор записывается для локальной транскрипции."
VOICE_INTERPRETER_RU_GREETING="Русский канал переводчика подключён. Вы услышите собеседника по-русски."
VOICE_INTERPRETER_EN_GREETING="English interpreter channel connected. You will hear the other speaker in English."
VOICE_AGENT_REPLY="Я вас слышу. Медиатракт IMS работает."
