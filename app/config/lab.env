# lab-docker IMS environment. Mirrors vendor/docker_open5gs .env conventions
# (herlesupreeth/docker_open5gs) remapped onto the lab5g bridge 172.22.0.0/24
# and the stand identity (MCC 001 / MNC 01 -> ims.mnc001.mcc001.3gppnetwork.org).
# No secrets live here; pass to compose with: docker compose --env-file lab.env
MCC=001
MNC=01
IMS_DOMAIN=ims.mnc001.mcc001.3gppnetwork.org
LAB_NETWORK_CIDR=172.22.0.0/24
LAB_DYNAMIC_IP_RANGE=172.22.0.128/25
INTERNET_DNN=internet
IMS_DNN=ims
INTERNET_UE_CIDR=10.45.0.0/16
INTERNET_UE_GATEWAY=10.45.0.1
INTERNET_UE_GATEWAY_CIDR=10.45.0.1/16
IMS_UE_CIDR=10.46.0.0/16
IMS_UE_GATEWAY=10.46.0.1
IMS_UE_GATEWAY_CIDR=10.46.0.1/16
UE1_IMSI=001010000000001
UE2_IMSI=001010000000002
UE1_MSISDN=1001
UE2_MSISDN=1002
PCSCF_SIP_PORT=5060
PCSCF_UDP_MTU=65535
ICSCF_SIP_PORT=5060
SCSCF_SIP_PORT=6060
RTPENGINE_NG_PORT=2223
RTPENGINE_CLI_PORT=9901
