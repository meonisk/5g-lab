{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-manifest.schema.json",
  "title": "IMS AI experiment run manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at_utc", "stage", "evidence_class", "scientific_claim_allowed", "design", "repository", "host", "privacy"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]+$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "stage": {"enum": ["ADMISSION", "PILOT", "MAIN", "CLOSED_ANALYSIS"]},
    "evidence_class": {"type": "string"},
    "scientific_claim_allowed": {"type": "boolean"},
    "design": {"type": "object", "required": ["id", "sha256", "status"]},
    "repository": {"type": "object", "required": ["commit", "dirty", "diff_sha256"]},
    "host": {"type": "object", "required": ["os", "cpu", "memory_bytes", "gpus"]},
    "privacy": {"type": "object", "required": ["raw_audio", "direct_identifiers", "pseudonym_key_id"]}
  },
  "additionalProperties": true
}
