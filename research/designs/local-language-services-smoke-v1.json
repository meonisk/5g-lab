{
  "schema_version": "1.0",
  "design_id": "local-language-services-smoke-v1",
  "design_status": "FROZEN_FOR_ADMISSION",
  "stage": "ADMISSION",
  "evidence_class": "INSTRUMENTATION_SMOKE",
  "scientific_claim_allowed": false,
  "purpose": "Validate separate IMS Russian-to-English translation and explicit opt-in private Russian transcription services without placing speech content in shareable evidence.",
  "scenario": "local-ims-language-services",
  "repetitions": 1,
  "factors": {
    "stt_backend": ["faster-whisper-base-ru-cpu-int8"],
    "llm_backend": ["qwen2.5-1.5b-instruct-ollama"],
    "translation_tts_backend": ["espeak-ng-en-us"],
    "translation_turns": [2],
    "transcription_calls": [1]
  },
  "outcomes": [
    "container_state",
    "container_cpu_percent",
    "container_memory_bytes",
    "pseudonymized_event_log",
    "russian_stt_presence",
    "english_only_translation_presence",
    "english_tts_rtp_delivery",
    "private_recording_created_and_finalized",
    "transcription_bypasses_llm"
  ],
  "capture": {
    "compose_project": "lab-docker",
    "containers": ["lab-pcscf", "lab-icscf", "lab-scscf", "lab-rtpengine", "lab-sip-as", "lab-media-adapter", "lab-ai-worker", "lab-llm-worker", "lab-voice-agent"],
    "log_tail_lines": 1000,
    "gates": [
      {"id": "5gs-connectivity", "command": ["bash", "scripts/verify.sh"]},
      {"id": "ims-connectivity", "command": ["bash", "scripts/verify-ims.sh"]},
      {"id": "ims-registration", "command": ["bash", "scripts/verify-ims-registration.sh"]},
      {"id": "ims-call-and-observe", "command": ["bash", "scripts/verify-ims-call.sh"]},
      {"id": "voice-agent", "command": ["bash", "scripts/verify-voice-agent.sh"]},
      {"id": "russian-to-english", "command": ["bash", "scripts/verify-real-ai-stream.sh"]},
      {"id": "private-transcription", "command": ["bash", "scripts/verify-transcription-recording.sh"]},
      {"id": "security-privacy", "command": ["bash", "scripts/verify-security.sh"]},
      {"id": "topology-literals", "command": ["python", "scripts/check-no-hardcoded-topology.py"]}
    ]
  },
  "privacy": {
    "raw_audio": "FORBIDDEN",
    "raw_payloads": "FORBIDDEN",
    "direct_identifiers": "PSEUDONYMIZE",
    "private_opt_in_recording": "ALLOWED_OUTSIDE_EVIDENCE",
    "pseudonymize_private_ips": false,
    "shareable_retention_days": 30
  },
  "admission_requires": ["working_tree_recorded", "design_hash_recorded", "container_image_ids_recorded", "secret_scan_pass", "acceptance_gates_pass"]
}
