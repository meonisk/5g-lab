{
  "schema_version": "1.0",
  "design_id": "local-instrumentation-smoke-v1",
  "design_status": "FROZEN_FOR_ADMISSION",
  "stage": "ADMISSION",
  "evidence_class": "INSTRUMENTATION_SMOKE",
  "scientific_claim_allowed": false,
  "purpose": "Validate provenance, bounded resource capture, pseudonymization, and live IMS evidence collection.",
  "scenario": "running-local-ims-baseline",
  "repetitions": 1,
  "factors": {
    "service_mode": ["deterministic_observe_and_terminate_baselines"],
    "offered_calls": [1]
  },
  "outcomes": [
    "container_state",
    "container_cpu_percent",
    "container_memory_bytes",
    "pseudonymized_event_log"
  ],
  "capture": {
    "compose_project": "lab-docker",
    "containers": [
      "lab-pcscf", "lab-icscf", "lab-scscf", "lab-rtpengine",
      "lab-sip-as", "lab-media-adapter", "lab-ai-worker", "lab-voice-agent"
    ],
    "log_tail_lines": 1000
  },
  "privacy": {
    "raw_audio": "FORBIDDEN",
    "raw_payloads": "FORBIDDEN",
    "direct_identifiers": "PSEUDONYMIZE",
    "pseudonymize_private_ips": false,
    "shareable_retention_days": 30
  },
  "admission_requires": [
    "working_tree_recorded",
    "design_hash_recorded",
    "container_image_ids_recorded",
    "secret_scan_pass",
    "acceptance_gates_pass"
  ]
}
