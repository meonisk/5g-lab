{
  "schema_version": "1.0",
  "design_id": "local-russian-conversation-smoke-v1",
  "design_status": "FROZEN_FOR_ADMISSION",
  "stage": "ADMISSION",
  "evidence_class": "INSTRUMENTATION_SMOKE",
  "scientific_claim_allowed": false,
  "purpose": "Validate a multi-turn Russian IMS call through local STT, bounded LLM context, TTS, and return RTP without retaining speech content.",
  "scenario": "running-local-ims-russian-multi-turn-loop",
  "repetitions": 1,
  "factors": {
    "stt_backend": ["faster-whisper-base-ru-cpu-int8"],
    "llm_backend": ["qwen2.5-0.5b-instruct-ollama"],
    "tts_backend": ["espeak-ng-ru"],
    "required_dialogue_turns": [2],
    "offered_calls": [1]
  },
  "outcomes": [
    "container_state",
    "container_cpu_percent",
    "container_memory_bytes",
    "pseudonymized_event_log",
    "live_pcmu_audio_duration_seconds",
    "russian_stt_transcript_presence",
    "local_stt_processing_ms",
    "russian_llm_response_presence",
    "local_llm_processing_ms",
    "russian_tts_rtp_delivery",
    "delivered_dialogue_turns"
  ],
  "capture": {
    "compose_project": "lab-docker",
    "containers": [
      "lab-pcscf", "lab-icscf", "lab-scscf", "lab-rtpengine",
      "lab-sip-as", "lab-media-adapter", "lab-ai-worker", "lab-llm-worker",
      "lab-voice-agent"
    ],
    "log_tail_lines": 1000,
    "gates": [
      {"id": "5gs-connectivity", "command": ["bash", "scripts/verify.sh"]},
      {"id": "ims-connectivity", "command": ["bash", "scripts/verify-ims.sh"]},
      {"id": "ims-registration", "command": ["bash", "scripts/verify-ims-registration.sh"]},
      {"id": "ims-call-and-observe", "command": ["bash", "scripts/verify-ims-call.sh"]},
      {"id": "voice-agent", "command": ["bash", "scripts/verify-voice-agent.sh"]},
      {"id": "russian-multi-turn-loop", "command": ["bash", "scripts/verify-real-ai-stream.sh"]},
      {"id": "security-privacy", "command": ["bash", "scripts/verify-security.sh"]},
      {"id": "topology-literals", "command": ["python", "scripts/check-no-hardcoded-topology.py"]}
    ]
  },
  "privacy": {
    "raw_audio": "FORBIDDEN",
    "raw_payloads": "FORBIDDEN",
    "direct_identifiers": "PSEUDONYMIZE",
    "pseudonymize_private_ips": false,
    "shareable_retention_days": 30
  },
  "admission_requires": [
    "working_tree_recorded",
    "design_hash_recorded",
    "container_image_ids_recorded",
    "secret_scan_pass",
    "acceptance_gates_pass"
  ]
}
