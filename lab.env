# lab-docker IMS environment. Mirrors vendor/docker_open5gs .env conventions
# (herlesupreeth/docker_open5gs) remapped onto the lab5g bridge 172.22.0.0/24
# and the stand identity (MCC 001 / MNC 01 -> ims.mnc001.mcc001.3gppnetwork.org).
# No secrets live here; pass to compose with: docker compose --env-file lab.env
MCC=001
MNC=01
IMS_DOMAIN=ims.mnc001.mcc001.3gppnetwork.org
LAB_NETWORK_CIDR=172.22.0.0/24
INTERNET_DNN=internet
IMS_DNN=ims
INTERNET_UE_CIDR=10.45.0.0/16
INTERNET_UE_GATEWAY=10.45.0.1
INTERNET_UE_GATEWAY_CIDR=10.45.0.1/16
IMS_UE_CIDR=10.46.0.0/16
IMS_UE_GATEWAY=10.46.0.1
IMS_UE_GATEWAY_CIDR=10.46.0.1/16
UE1_IMSI=001010000000001
UE2_IMSI=001010000000002
UE1_MSISDN=1001
UE2_MSISDN=1002
PCSCF_SIP_PORT=5060
PCSCF_UDP_MTU=65535
ICSCF_SIP_PORT=5060
SCSCF_SIP_PORT=6060
RTPENGINE_NG_PORT=2223
RTPENGINE_CLI_PORT=9901
RTPENGINE_PORT_MIN=30000
RTPENGINE_PORT_MAX=30100
SIP_UE_AUTO_ANSWER=200
SIP_CALL_DURATION_SECONDS=20
SIP_AS_PORT=5070
MEDIA_ADAPTER_PORT=8091
AI_WORKER_PORT=8092
MEDIA_OBSERVE_INTERVAL_SECONDS=2
MEDIA_SESSION_TTL_SECONDS=120
VOICE_AGENT_MSISDN=1003
VOICE_AGENT_SIP_USER=agent
VOICE_AGENT_HTTP_PORT=8093
VOICE_AGENT_RTP_PORT=41000
VOICE_AGENT_GREETING="Hello. The local IMS voice agent is online."
VOICE_AGENT_REPLY="I heard you. The IMS media path is working."
VOICE_AGENT_VAD_RMS=350
VOICE_AGENT_SILENCE_MS=700
VOICE_AGENT_CALL_TIMEOUT=300
PYHSS_API_BIND=127.0.0.1
PYHSS_API_PORT=8080
PYHSS_API_CONTAINER_PORT=8080
LOOPBACK_IP=127.0.0.1
DNS_UPSTREAM_PRIMARY=8.8.8.8
DNS_UPSTREAM_SECONDARY=8.8.4.4
INTERNET_PROBE_IP=8.8.8.8

# UPF (static: IMS containers route the UE ims pool via this address)
UPF_IP=172.22.0.3
# Open5GS SCP (static: referenced from the vendored P-CSCF N5 placeholders)
SCP_IP=172.22.0.5

# IMS lab services (static IPs, high range to avoid dynamic-lease collisions)
DNS_IP=172.22.0.100
RTPENGINE_IP=172.22.0.101
MYSQL_IP=172.22.0.102
PYHSS_IP=172.22.0.103
PYHSS_BIND_PORT=3868
ICSCF_IP=172.22.0.104
ICSCF_BIND_PORT=3869
SCSCF_IP=172.22.0.105
SCSCF_BIND_PORT=3870
PCSCF_IP=172.22.0.106
PCSCF_BIND_PORT=3871
SIP_AS_IP=172.22.0.107
AI_WORKER_IP=172.22.0.109
VOICE_AGENT_IP=172.22.0.110

# Legacy placeholder env consumed by vendored init sed pipelines
PCRF_BIND_PORT=3873
